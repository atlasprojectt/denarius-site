# Pedido de demonstração (/demonstracao → app/api/demo → lib/demo).
# Sem a chave: em desenvolvimento o pedido só aparece no terminal; em produção
# o formulário responde que o envio está indisponível e mostra o e-mail de
# contato.

# Obrigatória. Chave da API do Resend (resend.com → API Keys, "Sending access").
RESEND_API_KEY=

# Opcional. Quem recebe os pedidos; sem ela, o e-mail de contato do site
# (CONTACT_EMAIL em src/lib/links.ts). Sem domínio verificado no Resend, o
# destino precisa ser o e-mail dono da conta. Vários: separados por vírgula.
DEMO_TO_EMAIL=

# Opcional. O remetente. Sem ela, "Denarius <onboarding@resend.dev>", que
# funciona sem configurar domínio. Com o domínio verificado no Resend, algo
# como "Denarius <demo@usedenarius.pro>".
DEMO_FROM_EMAIL=
